{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/engineering-ops/work-record.schema.json",
  "title": "Engineering work record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "owner", "risk", "evidence", "decision", "stop_condition"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "risk": {"enum": ["routine", "elevated", "blocked"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "reference"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {"type": "string", "minLength": 1},
    "stop_condition": {"type": "string", "minLength": 1}
  }
}
